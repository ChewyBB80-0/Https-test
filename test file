```javascript name=synthetic-transaction-playwright.js
// Usage: BASE_URL=https://your-site.com node synthetic-transaction-playwright.js
// Install: npm install playwright
const { chromium } = require('playwright');

const BASE_URL = process.env.BASE_URL || 'https://example.com';
const SEARCH_TERM = process.env.SEARCH_TERM || 'test product';

function randDelay(min=200, max=1200) {
  return min + Math.floor(Math.random() * (max - min));
}

(async () => {
  const browser = await chromium.launch({ headless: true });
  const context = await browser.newContext({
    userAgent: 'SyntheticBot/1.0 (+https://example.com/synthetic)',
    viewport: { width: 1280, height: 800 },
  });
  const page = await context.newPage();
  const started = Date.now();
  try {
    console.log(JSON.stringify({ event: 'start', url: BASE_URL }));

    // Visit homepage
    await page.goto(BASE_URL, { waitUntil: 'networkidle' });
    await page.waitForTimeout(randDelay());

    // Search (adjust selector to your app)
    const searchSelector = 'input[name="q"], input[type="search"], #search';
    if (await page.$(searchSelector)) {
      await page.click(searchSelector);
      await page.fill(searchSelector, SEARCH_TERM);
      await page.keyboard.press('Enter');
      await page.waitForLoadState('networkidle');
      await page.waitForTimeout(randDelay());
    }

    // Click first product (adjust selector)
    const productSelector = '.product, .item, .listing .card';
    const firstProduct = await page.$(productSelector);
    if (firstProduct) {
      await firstProduct.click();
      await page.waitForLoadState('networkidle');
      await page.waitForTimeout(randDelay());
    }

    // Add to cart (adjust selector)
    const addToCartSelector = 'button.add-to-cart, button[name="add"], #add-to-cart';
    if (await page.$(addToCartSelector)) {
      await page.click(addToCartSelector);
      await page.waitForTimeout(randDelay(500, 1500));
    }

    // Go to cart (optional)
    const cartSelector = 'a[href*="/cart"], a[aria-label="Cart"], #cart';
    if (await page.$(cartSelector)) {
      await page.click(cartSelector);
      await page.waitForLoadState('networkidle');
      await page.waitForTimeout(randDelay());
    }

    // Capture a screenshot for monitoring retention
    const screenshotPath = `synthetic-screenshot-${Date.now()}.png`;
    await page.screenshot({ path: screenshotPath, fullPage: false });
    const duration = Date.now() - started;
    console.log(JSON.stringify({ event: 'complete', success: true, duration_ms: duration, screenshot: screenshotPath }));
  } catch (err) {
    const duration = Date.now() - started;
    console.error(JSON.stringify({ event: 'error', message: err.message, duration_ms: duration }));
    process.exitCode = 2;
  } finally {
    await browser.close();
  }
})();
```

```javascript name=synthetic-transaction-k6.js
import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  stages: [
    { duration: '30s', target: 10 },   // ramp to 10 VUs
    { duration: '1m', target: 10 },    // stay
    { duration: '30s', target: 0 },    // ramp down
  ],
  thresholds: {
    http_req_duration: ['p(95)<500'],  // 95% requests under 500ms
    'http_req_failed': ['rate<0.01'],
  },
};

const BASE_URL = __ENV.BASE_URL || 'https://example.com';

function randomPause() {
  // small randomized pause to avoid deterministic bursts
  sleep(0.5 + Math.random() * 1.5);
}

export default function () {
  // 1) Visit homepage
  let res = http.get(`${BASE_URL}/`);
  check(res, { 'home status 200': r => r.status === 200 });
  randomPause();

  // 2) Search (if search endpoint exists)
  const q = encodeURIComponent(__ENV.SEARCH_TERM || 'test product');
  res = http.get(`${BASE_URL}/search?q=${q}`);
  check(res, { 'search status 200': r => r.status === 200 });
  randomPause();

  // 3) Get product page (replace with actual product path or API)
  res = http.get(`${BASE_URL}/product/example-product`);
  check(res, { 'product status 200': r => r.status === 200 });
  randomPause();

  // 4) Add to cart (POST) — replace endpoint/payload with your API
  res = http.post(`${BASE_URL}/cart/add`, JSON.stringify({ productId: 'example-product', qty: 1 }), {
    headers: { 'Content-Type': 'application/json' },
  });
  check(res, { 'add-to-cart status 200': r => r.status === 200 || r.status === 201 });
  randomPause();
}
